ui_print ==============================================
ui_print =              SwiftFlash Installer          =
ui_print ==============================================
ui_print   Flashing OxygenOS for Poco F7 (Onyx)
ui_print ==============================================
ui_print  

ui_print  - Verifying device...
verify_device onyx

# Instantly set the progress bar to 10%
set_progress 0.1

ui_print  - Flashing standard partitions (A/B slots)...

package_flash_partition raw images/boot.img /dev/block/bootdevice/by-name/boot_a
package_flash_partition raw images/boot.img /dev/block/bootdevice/by-name/boot_b
set_progress 0.2

package_flash_partition raw images/dtbo.img /dev/block/bootdevice/by-name/dtbo_a
package_flash_partition raw images/dtbo.img /dev/block/bootdevice/by-name/dtbo_b
set_progress 0.3

package_flash_partition raw images/init_boot.img /dev/block/bootdevice/by-name/init_boot_a
package_flash_partition raw images/init_boot.img /dev/block/bootdevice/by-name/init_boot_b
set_progress 0.4

package_flash_partition raw images/vendor_boot.img /dev/block/bootdevice/by-name/vendor_boot_a
package_flash_partition raw images/vendor_boot.img /dev/block/bootdevice/by-name/vendor_boot_b
set_progress 0.5

package_flash_partition raw images/vbmeta.img /dev/block/bootdevice/by-name/vbmeta_a
package_flash_partition raw images/vbmeta.img /dev/block/bootdevice/by-name/vbmeta_b
set_progress 0.6

package_flash_partition raw images/vbmeta_system.img /dev/block/bootdevice/by-name/vbmeta_system_a
package_flash_partition raw images/vbmeta_system.img /dev/block/bootdevice/by-name/vbmeta_system_b
set_progress 0.7

ui_print  - Decompressing and flashing Super partition...
ui_print  - (This will take a few minutes...)

# Tell recovery to slowly fill the next 30% of the bar over 180 seconds
show_progress 0.3 180

# ==============================================================
# NOTE: Leave the ONE you are using uncommented. 
# Put a '#' in front of the ones you are NOT using.
# ==============================================================
package_flash_partition zstd images/super.bin.zst /dev/block/bootdevice/by-name/super
# package_flash_partition gzip images/super.img.gz /dev/block/bootdevice/by-name/super
# package_flash_partition 7z images/super.7z /dev/block/bootdevice/by-name/super

# Instantly set the bar to 100% when finished
set_progress 1.0

ui_print  
ui_print  - Flashing Complete!
ui_print  - Please reboot your device.
