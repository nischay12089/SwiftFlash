# Option 1: If your super image is ZSTD compressed
package_flash_partition zstd images/super.bin.zst /dev/block/bootdevice/by-name/super

# Option 2: If your super image is GZIP compressed
# package_flash_partition gzip images/super.img.gz /dev/block/bootdevice/by-name/super

# Option 3: If your super image is inside a 7z archive
# package_flash_partition 7z images/super.7z /dev/block/bootdevice/by-name/super

